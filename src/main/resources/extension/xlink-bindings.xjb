<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
               xmlns:xs="http://www.w3.org/2001/XMLSchema"
               xmlns:xlink="http://www.w3.org/1999/xlink">
    
    <jaxb:bindings schemaLocation="xlinks.xsd">
        <jaxb:bindings node="//xs:complexType[@name='titleEltType']">
            <jaxb:class name="XLinkTitleElement"/>
        </jaxb:bindings>
        
        <jaxb:bindings node="//xs:complexType[@name='resourceType']">
            <jaxb:class name="XLinkResource"/>
        </jaxb:bindings>
        
        <jaxb:bindings node="//xs:element[@name='title']">
            <jaxb:property name="xlinkTitle"/>
        </jaxb:bindings>
        
        <jaxb:bindings node="//xs:attribute[@name='title']">
            <jaxb:property name="titleAttribute"/>
        </jaxb:bindings>
    </jaxb:bindings>
</jaxb:bindings>
