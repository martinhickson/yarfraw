<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://purl.org/rss/1.0/modules/slash/"
	xmlns:slash="http://purl.org/rss/1.0/modules/slash/"
	xmlns:jxb="http://java.sun.com/xml/ns/jaxb"
	jxb:version="1.0"
	elementFormDefault="unqualified">
	<xs:element name="slashExtension">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="slash:comments" >
<xs:annotation>
<xs:documentation><![CDATA[ 
<p>
     Slash is the source code and database that was originally used to
     create Slashdot, and has now been released under the GNU General Public
     License. It is a bona fide Open Source / Free Software project.
    </p>
    <p>
     The Slash RSS 1.0 module augments the RSS core and 
     <a href="http://purl.org/rss/1.0/modules/dc/">Dublin Core</a>
     module's metadata with channel and item-level elements specific
     to Slash-based sites.
						]]> 
						</xs:documentation>
</xs:annotation>				
				</xs:element>
				<xs:element ref="slash:department" >
<xs:annotation>
