<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:wfw="http://wellformedweb.org/CommentAPI/"
	targetNamespace="http://wellformedweb.org/CommentAPI/"
	elementFormDefault="qualified">

	<xs:annotation>
		<xs:documentation>
			wfw namespace elements
		</xs:documentation>
	</xs:annotation>
	
	<xs:element name="wellFormedWebExtension">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="wfw:comment" />
				<xs:element ref="wfw:commentRss" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
 	<xs:element name="comment" type="xs:string" >
		<xs:annotation>
			<xs:documentation>This element appears in RSS feeds and contains the URI that comment entries are to be POSTed to.</xs:documentation>
		</xs:annotation>
	</xs:element>
 	<xs:element name="commentRss" type="xs:string" >
		<xs:annotation>
			<xs:documentation>This element also appears in RSS feeds and contains the URI of the RSS feed for comments on that Item.</xs:documentation>
		</xs:annotation>
	</xs:element>	
</xs:schema>
