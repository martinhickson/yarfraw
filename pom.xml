  <profiles>
  	<profile>
  	  <id>dev</id>
  	  <build>
  	  	<plugins>
		  	  <plugin>
		        <artifactId>maven-surefire-plugin</artifactId>
		        <configuration>
		          <forkMode>always</forkMode>
		          <includes>
		            <list>**/*Test.java</list>
		          </includes>
        		</configuration>
      		</plugin>
    	</plugins>
  	</build>
      <activation>
        <property>
          <name>env</name>
          <value>dev</value>
        </property>
      </activation>
  	</profile>
  </profiles>
  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.wagon</groupId>
        <artifactId>wagon-ftp</artifactId>
        <version>1.0-alpha-6</version>
      </extension>
    </extensions>
    <defaultGoal>package</defaultGoal>
    <plugins>
      <plugin>
        <artifactId>maven-release-plugin</artifactId>
        <configuration>
          <tagBase>https://yarfraw.svn.sourceforge.net/svnroot/yarfraw/yarfraw/tags</tagBase>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <configuration>
          <filesets>
            <fileset>
              <directory>${basedir}</directory>
              <includes>
                <include>cobertura.ser</include>
                <include>velocity.log</include>
                <include>testTmpOutput/*.xml</include>
                <include>testTmpOutput/atom10/*.xml</include>
                <include>testTmpOutput/rss10/*.xml</include>
                <include>testTmpOutput/rss20/*.xml</include>
                <include>testTmpOutput/coverage/*.xml</include>
              </includes>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>cobertura-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>cobertura-maven-plugin</artifactId>
        <version>2.0</version>
        <executions>
          <execution>
            <id>clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jvnet.jaxb2.maven2</groupId>
        <artifactId>maven-jaxb2-plugin</artifactId>
        <executions>
          <execution>
            <id>atom10</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <generatePackage>yarfraw.generated.atom10.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>atom10.xsd</schemaInclude>
              </schemaIncludes>
              <generateDirectory>${project.build.directory}/generated-sources/atom10</generateDirectory>
            </configuration>
          </execution>
          <execution>
            <id>atom03</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <generatePackage>yarfraw.generated.atom03.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>atom03.xsd</schemaInclude>
              </schemaIncludes>
              <generateDirectory>${project.build.directory}/generated-sources/atom03</generateDirectory>
            </configuration>
          </execution>          
          <execution>
            <id>rss20</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <generatePackage>yarfraw.generated.rss20.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>rss20.xsd</schemaInclude>
              </schemaIncludes>
              <generateDirectory>${project.build.directory}/generated-sources/rss20</generateDirectory>
            </configuration>
          </execution>
          <execution>
            <id>rss10</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.rss10.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>rss10*.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/rss10</generateDirectory>
              <strict>false</strict>
            </configuration>
          </execution>
          <execution>
            <id>atom03ext</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.atom03.ext.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/atom03.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/atom03ext</generateDirectory>
            </configuration>
          </execution>           
          <execution>
            <id>itunes</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.itunes.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/itunes.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/itunes</generateDirectory>
            </configuration>
          </execution> 
          <execution>
            <id>googleBase</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.googlebase.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/gbase.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/googlebase</generateDirectory>
            </configuration>
          </execution>                    
          <execution>
            <id>mrss</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.mrss.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/mrss.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/mrss</generateDirectory>
            </configuration>
          </execution>  
          <execution>
            <id>georss</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>false</strict>
              <schemaIncludes>
                <schemaInclude>extension/georss.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/georss</generateDirectory>
            </configuration>
          </execution>  
          <execution>
            <id>wfw</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.wfw.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/wfw.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/wfw</generateDirectory>
            </configuration>
          </execution>
          <execution>
            <id>blogger</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.blogger.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/bloggerAtom.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/blogger</generateDirectory>
            </configuration>
          </execution>
          <execution>
            <id>admin</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.admin.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/admin.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/admin</generateDirectory>
            </configuration>
          </execution>                                      
          <execution>
            <id>feedburner</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.feedburner.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/feedburner.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/feedburner</generateDirectory>
            </configuration>
          </execution>
          <execution>
            <id>slash</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <verbose>true</verbose>
              <strict>true</strict>
              <generatePackage>yarfraw.generated.slash.elements</generatePackage>
              <schemaIncludes>
                <schemaInclude>extension/slash.xsd</schemaInclude>
              </schemaIncludes>
              <forceRegenerate>true</forceRegenerate>
              <generateDirectory>${project.build.directory}/generated-sources/extension/slash</generateDirectory>
            </configuration>
          </execution>                              
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <inherited>true</inherited>
        <configuration>
          <compilerArgument>-Xlint:all,-deprecation</compilerArgument>
          <showWarnings>true</showWarnings>
          <source>1.5</source>
          <target>1.5</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkMode>always</forkMode>
          <includes>
            <list>**/*Test.java</list>
            <list>**/*TestSlow.java</list>
          </includes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-site-map</id>
            <phase>site</phase>
            <configuration>
              <tasks>
                <echo>Creating sitemap.xml using the sitemap_gen tool from google. This requires python. Swith the direction of the slash if you are on Windows</echo>
                <exec executable="python" failonerror="true" failifexecutionfails="true">
                  <arg value="bin/sitemap_gen/sitemap_gen.py" />
                  <arg value="--config=config.xml" />
                </exec>              
              </tasks>
            </configuration>
            <goals>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>      
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>java.net</id>
