<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <groupId>yarfraw</groupId>
  <artifactId>yarfraw</artifactId>
  <packaging>jar</packaging>
  <name>YARFRAW - Yet Another RSS Feed Reader And Writer API</name> 
  <version>0.7-SNAPSHOT</version>
  <modelVersion>4.0.0</modelVersion>
  <description>
	Title says all, this is just another rss feed reader and writer API library. 
  </description>
  <url>http://yarfraw.sourceforge.net/</url>
  <licenses>
  	<license>
  		<name>Apache License 2.0</name>
  		<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
  	</license>
  </licenses>
  <scm>
    <connection>scm:svn:https://yarfraw.svn.sourceforge.net/svnroot/yarfraw/</connection>
    <developerConnection>scm:svn:https://zl25-drexel@yarfraw.svn.sourceforge.net/svnroot/yarfraw/</developerConnection>
    <url>scm:svn:https://yarfraw.svn.sourceforge.net/svnroot/yarfraw/</url>
  </scm>
  <mailingLists>
    <mailingList>
      <name>User List</name>
      <subscribe>http://lists.sourceforge.net/lists/listsinfo/yarfraw-users</subscribe>
      <unsubscribe>http://lists.sourceforge.net/lists/listsinfo/yarfraw-users</unsubscribe>
      <post>yarfraw-users@lists.sourceforge.net</post>
    </mailingList>
    <mailingList>
      <name>Developer List</name>
      <subscribe>http://lists.sourceforge.net/mailman/listinfo/yarfraw-devel</subscribe>
      <unsubscribe>http://lists.sourceforge.net/mailman/listinfo/yarfraw-devel</unsubscribe>
      <post>yarfraw-devel@lists.sourceforge.net</post>
    </mailingList>
    <mailingList>
      <name>Commit List</name>
      <subscribe>http://lists.sourceforge.net/mailman/listinfo/yarfraw-commits</subscribe>
      <unsubscribe>http://lists.sourceforge.net/mailman/listinfo/yarfraw-commits</unsubscribe>
      <post>yarfraw-commits@lists.sourceforge.net</post>
    </mailingList>
  </mailingLists>
  <issueManagement>
  	<system>Sourceforge</system>
  	<url>https://sourceforge.net/tracker/?group_id=203266</url>
  </issueManagement>
  <distributionManagement>
    <snapshotRepository>
      <id>snapshots</id>
      <uniqueVersion>true</uniqueVersion>
      <url>sftp://tux.cs.drexel.edu/home/zl25/public_html/maven2/snapshot</url>
    </snapshotRepository>    
    <repository>
      <id>central</id>
      <uniqueVersion>false</uniqueVersion>
      <url>sftp://tux.cs.drexel.edu/home/zl25/public_html/maven2/repo</url>
    </repository>  
    <site>
      <id>website</id>
      <url>scp://zl25-drexel@shell.sf.net:/home/groups/y/ya/yarfraw/htdocs/</url>
    </site>    
  </distributionManagement>
  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.wagon</groupId>
         <artifactId>wagon-ftp</artifactId>
         <version>1.0-alpha-6</version>
      </extension>
    </extensions> 
	<defaultGoal>package</defaultGoal>
    <plugins>  
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
          <configuration>
            <tagBase>https://yarfraw.svn.sourceforge.net/svnroot/yarfraw/tags</tagBase>
          </configuration>
      </plugin>     
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-clean-plugin</artifactId>
         <configuration>
           <filesets>
             <fileset>
               <directory>${basedir}</directory>
               <includes>
                 <include>cobertura.ser</include>
                 <include>velocity.log</include>
               </includes>
             </fileset>
           </filesets>
         </configuration>
       </plugin>
   
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>cobertura-maven-plugin</artifactId>
      </plugin>    
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>cobertura-maven-plugin</artifactId>
        <version>2.0</version>
        <executions>
          <execution>
            <id>clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>    
      <plugin>
        <groupId>org.jvnet.jaxb2.maven2</groupId>
        <artifactId>maven-jaxb2-plugin</artifactId>
        
        <executions>
          <execution>
          	<id>rss20</id>
	        <configuration>
	        	<verbose>true</verbose>
	        	<generatePackage>yarfraw.generated.rss20.elements</generatePackage>
	        	<schemaIncludes>
	        		<schemaInclude>rss20*.xsd</schemaInclude>
	        	</schemaIncludes>
	        	<generateDirectory>${project.build.directory}/generated-sources/rss20</generateDirectory>
	        </configuration>  
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
		  <execution>
		  	<id>rss10</id>
	        <configuration>
	        	<verbose>true</verbose>
	        	<generatePackage>yarfraw.generated.rss10.elements</generatePackage>
	        	<schemaIncludes>
	        		<schemaInclude>rss10*.xsd</schemaInclude>
	        	</schemaIncludes>
	        	<forceRegenerate>true</forceRegenerate>
	        	<generateDirectory>${project.build.directory}/generated-sources/rss10</generateDirectory>
	        </configuration>  
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>          
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <inherited>true</inherited>
        <configuration>
		  <compilerArgument>-Xlint:all,-deprecation</compilerArgument>
          <showWarnings>true</showWarnings>
          <source>1.5</source>
          <target>1.5</target>
        </configuration>
      </plugin>     
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkMode>always</forkMode>
          <includes>
            <list>**/*Test.java</list>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <pluginRepositories>
    <pluginRepository>
      <id>maven2-repository.dev.java.net</id>
      <url>https://maven2-repository.dev.java.net/nonav/repository</url>
    </pluginRepository>
    <pluginRepository>
      <id>maven-repository.dev.java.net</id>
      <url>https://maven-repository.dev.java.net/nonav/repository</url>
      <layout>legacy</layout>
    </pluginRepository>
  </pluginRepositories>
  
  <dependencies>
    <dependency>
      <groupId>commons-httpclient</groupId>
      <artifactId>commons-httpclient</artifactId>
      <version>3.1-beta1</version>
    </dependency>  
	<dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2</version>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>1.3.1</version>
    </dependency>    
    <dependency>
      <groupId>commons-lang</groupId>
      <artifactId>commons-lang</artifactId>
      <version>2.3</version>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <version>2.0.3</version>
    </dependency>
    <dependency>
      <groupId>javax.xml</groupId>
      <artifactId>jaxb-api</artifactId>
      <version>2.1</version>
    </dependency>
  </dependencies>
  <developers>
  	<developer>
  		<id>zl25-drexel</id>
  		<name>Jay Liang</name>
  	</developer>
  </developers>
	<reporting>
	 <plugins>
		<plugin>
			<artifactId>maven-pmd-plugin</artifactId>
			<configuration>
				<linkXref>true</linkXref>
				<sourceEncoding>utf-8</sourceEncoding>
				<minimumTokens>80</minimumTokens>
				<targetJdk>1.5</targetJdk>
				<excludes>
					<exclude>**/yarfraw/generated/rss?0/elements/*.java</exclude>
				</excludes>
			</configuration>
		</plugin>
		<plugin>
			<groupId>org.codehaus.mojo</groupId>
			<artifactId>jdepend-maven-plugin</artifactId>
		</plugin>
		  <plugin>
		    <groupId>org.codehaus.mojo</groupId>
		    <artifactId>findbugs-maven-plugin</artifactId>
		    <configuration>
		      <threshold>Exp</threshold>
		      <effort>Max</effort>
		      <excludeFilterFile>findbugs-exclude.xml</excludeFilterFile>
		      <includeFilterFile>findbugs-include.xml</includeFilterFile>
		      <visitors>FindDeadLocalStores,UnreadFields</visitors>
		      <omitVisitors>FindDeadLocalStores,UnreadFields</omitVisitors>
		    </configuration>
		  </plugin>				
		<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jxr-maven-plugin</artifactId>
			</plugin>	 
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-changes-plugin</artifactId>
        <reportSets>
          <reportSet>
            <reports>
              <report>changes-report</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>	 
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-project-info-reports-plugin</artifactId>
      </plugin>	 
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <minmemory>128m</minmemory>
          <maxmemory>512</maxmemory>
          <links>
            <list>
              http://java.sun.com/j2se/1.5.0/docs/api
            </list>
            <list>
              http://java.sun.com/javaee/5/docs/api/
            </list>
          </links>
          <source>1.5</source>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>cobertura-maven-plugin</artifactId>
      </plugin>
  	</plugins>
  </reporting>
</project>